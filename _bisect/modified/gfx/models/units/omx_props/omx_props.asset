# Omniluxia generated unit props (tools/model_pipeline/units). One entity per mesh x colour atlas.
# *_z meshes are the same prop stood upright for spear-animation slots.

pdxmesh = {
	name = "omx_elven_longbow_half_elf_mesh"
	file = "omx_elven_longbow.mesh"
	meshsettings = {
		name = "omx_elven_longbowShape"
		index = 0
		texture_diffuse = "omx_props_half_elf_diffuse.dds"
		texture_normal = "omx_props_normal.dds"
		texture_specular = "omx_props_properties.dds"
		shader = "standard"
		shader_file = "gfx/FX/pdxmesh.shader"
	}
}
entity = {
	name = "omx_elven_longbow_half_elf_entity"
	pdxmesh = "omx_elven_longbow_half_elf_mesh"
}

