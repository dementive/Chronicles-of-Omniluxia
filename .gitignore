.env

# Local caches, scratch work, and temporary exports
__pycache__/
*.py[cod]
/tmp/
/scratch/
/terrain_mask_backup_*/
*.tmp
*.bak

# Generated validation reports and image previews
/tiger_report.txt
/tiger_fresh_report.txt
/assets/icon_sources/*-preview.png
/assets/icon_sources/*_preview.png
/assets/icon_sources/trait_style_reference.png
/gfx/interface/icons/traits/*_preview.png

# Local backups made before automated edits (keep on disk, never commit)
/_audit_backup_*/

# Per-feature tiger validation reports and preview images in tools/
/tools/*_tiger_report.txt
/tools/*_preview.png

# Local validation output, previews, and terrain backups
/tools/*.log
/tools/*_tiger_targeted.txt
/tools/assets/
/assets/portrait_backgrounds/previews/

