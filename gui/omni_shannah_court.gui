		}textbox = { position = { 24 597 } size = { 550 24 } using = BaseFontM fontsize = 16 fontcolor = { 0.91 0.74 0.42 1 } multiline = yes text = "omni_hc_council" }textbox = { position = { 24 620 } size = { 550 18 } using = BaseFontM fontsize = 12 fontcolor = { 0.69 0.72 0.70 1 } multiline = yes text = "omni_hc_council_reward" }button = { position = { 600 597 } size = { 120 36 }
			texture = "gfx/interface/base_parts/button_color_400fs.dds"
			spriteType = Corneredtiled spriteborder = { 200 200 }
			gfxtype = framedbuttongfx framesize = { 200 200 }
			upframe = 1 overframe = 2 downframe = 3 disableframe = 1
			visible = "[GetScriptedGui('omni_hc_council').IsShown( GuiScope.SetRoot( Player.MakeScope ).End )]"
			enabled = "[GetScriptedGui('omni_hc_council').IsValid( GuiScope.SetRoot( Player.MakeScope ).End )]"
			tooltip = "omni_hc_council_tt"
			onclick = "[GetScriptedGui('omni_hc_council').Execute( GuiScope.SetRoot( Player.MakeScope ).End )]"
			textbox = { using = BaseFontM autoresize = yes parentanchor = center widgetanchor = center text = "omni_hc_convene" }
		}
	}state = {
		name = omni_hc_focus_capital
		trigger_when = "[GetScriptedGui('omni_hc_has_see').IsShown( GuiScope.SetRoot( Player.MakeScope ).End )]"
		on_start = "[PanToProvince( Player.MakeScope.GetVariable('omni_hc_see').GetCountry.GetCapital )]"
	}

