# Standalone message window, following FMO's ages-window lifecycle.

message_window = {
	
	name = "omni_shannah_court"
	
	size = { 780 864 }
	
	position = { 420 150 }
	
	movable = yes
    allow_outside = yes
	
	blockoverride "Title_text" { text = "" }
	
	blockoverride "White_buttons" {
		
		button_close = { tooltip = "CLOSE"
			
			onclick = "[GetVariableSystem.Clear('omni_hc_picker')]"
 onclick = "[GetVariableSystem.Clear('omni_sf_panel')]"
			
			onclick = "[ExecuteConsoleCommand('gui.ClearWidgets omni_shannah_court')]" }
		
	}
	
	widget = {
		
		position = { 18 178 } size = { 744 640 }
		visible = "[Not(GetScriptedGui('omni_hc_admin').IsShown( GuiScope.SetRoot( Player.MakeScope ).End ))]"
		
		background = { position = { 0 0 } size = { 744 640 }
			
			shaderfile = "gfx/FX/pdxgui_default.shader"
			
			texture = "gfx/interface/base_parts/background_black_texture.dds"
			
			spriteType = Corneredtiled spriteborder = { 12 12 } alpha = 0.65 }
		background = { position = { 8 4 } size = { 728 36 }
			
			texture = "gfx/interface/base_parts/header_l_pattern_x0bd.dds"
			
			shaderfile = "gfx/FX/pdxgui_default.shader"
			
			spriteType = Corneredtiled spriteborder = { 16 0 }
			
			color = { 0.72 0.48 0.20 1 } alpha = 0.35 }
		background = { position = { 20 211 } size = { 704 2 }
			
			texture = "gfx/interface/base_parts/header_l_pattern_x0bd.dds"
			
			shaderfile = "gfx/FX/pdxgui_default.shader"
			
			spriteType = Corneredtiled spriteborder = { 16 0 }
			
			color = { 0.72 0.48 0.20 1 } alpha = 0.8 }
		textbox = { position = { 22 12 } size = { 680 26 }
			
			using = BaseFontM fontsize = 18 fontcolor = { 0.91 0.74 0.42 1 }
			
			text = "omni_sf_ui_subtitle" multiline = yes }
		
		
		widget = {
			
			position = { 20 50 } size = { 704 160 }
			
			visible = "[GetScriptedGui('omni_sf_has_relationship').IsShown( GuiScope.SetRoot( Player.MakeScope ).End )]"
			
			portrait_button = {
				using = pt_button
				position = { 0 0 }
				blockoverride "PortraitSize" { size = { 90 136 } }
				datacontext = "[Player.MakeScope.GetVariable('omni_sf_shannah').GetCharacter]"
				pop_out = no
				blockoverride "portrait_button_template_tooltip" {
					tooltip = "omni_hc_shannah_portrait_tt"
				}
			}
			
			textbox = { position = { 112 0 } size = { 470 20 }
				
				using = BaseFontM fontsize = 13 fontcolor = { 0.69 0.72 0.70 1 }
				
				text = "omni_sf_ui_patron" multiline = yes }
			textbox = { position = { 112 21 } size = { 450 28 }
				
				using = BaseFontM fontsize = 23 fontcolor = { 0.91 0.74 0.42 1 }
				
				text = "omni_sf_ui_name" multiline = yes }
			textbox = { position = { 112 55 } size = { 450 24 }
				
				using = BaseFontM fontsize = 15 fontcolor = { 0.94 0.91 0.82 1 }
				
				text = "omni_sf_ui_disposition" multiline = yes }
			textbox = { position = { 112 85 } size = { 250 20 }
				
				using = BaseFontM fontsize = 12 fontcolor = { 0.69 0.72 0.70 1 }
				
				text = "omni_sf_ui_standing_label" multiline = yes }
			textbox = { position = { 374 85 } size = { 200 22 }
				
				using = BaseFontM fontsize = 17 fontcolor = { 0.91 0.74 0.42 1 }
				
				text = "omni_sf_ui_favor" multiline = yes }
			
			
			progressbar = {
				
				position = { 112 108 } size = { 450 12 }
				
				using = progressbar_yellow_horizontal
				
				value = "[FixedPointToFloat( GuiScope.SetRoot( Player.MakeScope ).ScriptValue('omni_sf_favor_fraction') )]"
				
				tooltip = "omni_sf_favor_tt"
				
			}
			
			icon = { position = { 576 -4 } size = { 112 112 } texture = "gfx/interface/omniluxia/shannah_court_seal.dds" }
			
			textbox = { position = { 112 122 } size = { 550 23 }
				
				using = BaseFontM fontsize = 16 fontcolor = { 0.91 0.74 0.42 1 }
				
				text = "omni_sf_ui_standing" multiline = yes }
			textbox = { position = { 112 147 } size = { 578 20 }
				
				using = BaseFontM fontsize = 12 fontcolor = { 0.69 0.72 0.70 1 }
				
				text = "omni_sf_ui_court_remark" multiline = yes }
			
			
		}
		
		textbox = { position = { 28 82 } size = { 670 90 }
			
			using = BaseFontM fontcolor = { 0.94 0.91 0.82 1 } multiline = yes
			
			visible = "[Not(GetScriptedGui('omni_sf_has_relationship').IsShown( GuiScope.SetRoot( Player.MakeScope ).End ))]"
			
			text = "omni_sf_ui_no_patron"
			
		}
		
		textbox = { position = { 22 220 } size = { 680 25 }
			
			using = BaseFontM fontsize = 18 fontcolor = { 0.91 0.74 0.42 1 }
			
			text = "omni_sf_ui_requests" multiline = yes }
		widget = { position = { 20 252 } size = { 704 45 }
			background = { position = { 0 0 } size = { 704 45 }
				
				shaderfile = "gfx/FX/pdxgui_default.shader"
				
				texture = "gfx/interface/base_parts/background_black_texture.dds"
				
				spriteType = Corneredtiled spriteborder = { 12 12 } alpha = 0.65 }
			icon = { position = { 9 7 } size = { 30 30 } texture = "gfx/interface/icons/shared_icons/omen.dds" }
			textbox = { position = { 50 1 } size = { 300 23 }
				
				using = BaseFontM fontsize = 17 fontcolor = { 0.94 0.91 0.82 1 }
				
				text = "omni_sf_ui_title_1" multiline = yes }
			textbox = { position = { 50 24 } size = { 310 20 }
				
				using = BaseFontM fontsize = 13 fontcolor = { 0.69 0.72 0.70 1 }
				
				text = "omni_sf_ui_effect_1" multiline = yes }
			textbox = { position = { 378 1 } size = { 166 22 }
				
				using = BaseFontM fontsize = 17 fontcolor = { 0.91 0.74 0.42 1 }
				
				text = "omni_sf_ui_price_1" multiline = yes }
			textbox = { position = { 378 23 } size = { 196 20 }
				
				using = BaseFontM fontsize = 11 fontcolor = { 0.69 0.72 0.70 1 }
				
				text = "omni_sf_ui_status_1" multiline = yes }
			button = { position = { 580 5 } size = { 114 36 }
				
				visible = "[Not(GetScriptedGui('omni_sf_request_1').IsValid( GuiScope.SetRoot( Player.MakeScope ).End ))]"
				
				datacontext = "[GetScriptedGui('omni_sf_request_1')]"
				
				enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot( Player.MakeScope ).End )]"
				
				tooltip = "omni_sf_ui_omni_sf_request_1_tip"
				
				texture = "gfx/interface/base_parts/button_color_400fs.dds"
				
				spriteType = Corneredtiled spriteborder = { 200 200 }
				
				gfxtype = framedbuttongfx framesize = { 200 200 }
				
				upframe = 1 overframe = 2 downframe = 3 disableframe = 1
				
				color = { 0.40 0.29 0.18 1 }
				
				clicksound = "event:/SFX/UI/Generic/2.0/sfx_ui_button_primary"
				
				textbox = { widgetanchor = center parentanchor = center
					
					autoresize = yes using = BaseFontS
					
					align = center fontcolor = { 0.66 0.58 0.45 1 } text = "omni_sf_ui_request" }
				
				onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( Player.MakeScope ).End )]"
				
				onclick = "[GetVariableSystem.Clear('omni_hc_picker')]"
 onclick = "[GetVariableSystem.Clear('omni_sf_panel')]"
				
				onclick = "[ExecuteConsoleCommand('gui.ClearWidgets omni_shannah_court')]"
				
