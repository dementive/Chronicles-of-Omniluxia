message_window = { name = "omni_helluvian_targets" size = { 620 720 } position = { 500 150 } movable = yes
    allow_outside = yes
        blockoverride "Title_text" { text = "" }
        blockoverride "White_buttons" { button_close = { onclick = "[ExecuteConsoleCommand('gui.ClearWidgets omni_helluvian_targets')]" tooltip = "CLOSE" } }
        textbox = { position = { 20 42 } size = { 580 66 } using = BaseFontM multiline = yes text = "omni_hc_select_desc" }
        textbox = { position = { 20 125 } size = { 560 70 } using = BaseFontM multiline = yes text = "omni_hc_empty" visible = "[IsDataModelEmpty(Player.MakeScope.GetList('omni_hc_recipients'))]" }
        scrollarea = { position = { 20 118 } size = { 580 570 } scrollbarpolicy_horizontal = always_off
            using = VerticalScrollAreaCutOff scrollbar_vertical = { using = VerticalScrollBar }
            scrollwidget = { dynamicgridbox = { datamodel = "[Player.MakeScope.GetList('omni_hc_recipients')]"
                item = { widget = { size = { 550 42 }
                    button = { texture = "gfx/interface/base_parts/button_color_400fs.dds"
        spriteType = Corneredtiled spriteborder = { 200 200 }
        gfxtype = framedbuttongfx framesize = { 200 200 }
        upframe = 1 overframe = 2 downframe = 3 disableframe = 1 size = { 550 38 }
                        enabled = "[GetScriptedGui('omni_hc_select_recipient').IsValid( GuiScope.SetRoot( Scope.GetCountry.MakeScope ).AddScope('player', Player.MakeScope ).End )]"
                        tooltip = "[Scope.GetCountry.GetDescriptiveName]"
                        onmousehierarchyenter = "[SetHighlightCountry(Scope.GetCountry)]"
                        onmousehierarchyleave = "[ClearHighlightColors]"
                        onclick = "[GetScriptedGui('omni_hc_select_recipient').Execute( GuiScope.SetRoot( Scope.GetCountry.MakeScope ).AddScope('player', Player.MakeScope ).End )]"
                        onclick = "[ExecuteConsoleCommand('gui.ClearWidgets omni_helluvian_targets')]"
                        icon = { position = { 6 3 } size = { 32 32 }
                            texture = "[Scope.GetCountry.AccessCoatOfArms.GetTexture('(int32)56','(int32)56')]"
                            frame = "[Scope.GetCountry.AccessCoatOfArms.GetFrame('(int32)56','(int32)56')]" framesize = { 56 56 } }
                        textbox = { position = { 48 7 } size = { 490 25 } using = BaseFontM text = "[Scope.GetCountry.GetName]" }
                    }
                } }
            } }
        }
    
    # Generated Helluvian ornaments; allow the pediment to extend above the window.
    widget = {
        name = "omni_hc_event_frame"
        size = { 620 32 }
        allow_outside = yes
        background = {
            position = { 0 -6 } size = { 620 40 }
            texture = "gfx/interface/white.dds"
            shaderfile = "gfx/FX/pdxgui_default.shader"
            color = { 0.36 0.07 0.07 1 }
        }
        icon = {
            size = { 620 137 }
            texture = "gfx/interface/omniluxia/helluvian_court_top_v1.dds"
            widgetanchor = bottom
            position = { 0 -6 }
        }
        textbox = {
            position = { 32 3 } size = { 556 28 }
            using = HeaderFont using = Highlight_FontColor
            align = center text = "omni_hc_select"
        }
        button_close = {
            position = { -8 3 } parentanchor = top|right widgetanchor = top|right
            tooltip = "CLOSE"
            onclick = "[ExecuteConsoleCommand('gui.ClearWidgets omni_helluvian_targets')]"
        }
    }
    icon = {
        position = { 0 -6 } size = { 384 72 }
        texture = "gfx/interface/omniluxia/helluvian_court_bottom_v1.dds"
        widgetanchor = top|hcenter parentanchor = bottom|hcenter
    }

}
