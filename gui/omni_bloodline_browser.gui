# Generated by tools/build_bloodline_browser.py. Created once per explicit open.
base_window = {
    gfxtype = windowgfx
    name = "omni_bloodline_browser"
    size = { 1000 704 }
    parentanchor = top|left
    widgetanchor = top|left
    using = main_window_template
    visible = "[And(Player.Exists, GetVariableSystem.Exists('omni_bloodline_browser'))]"

    state = {
        name = omni_bl_close_panel
        on_start = "[GetScriptedGui('omni_bl_close').Execute( GuiScope.SetRoot( Player.MakeScope ).End )]"
        on_start = "[GetVariableSystem.Clear('omni_bl_marriage_menu')]"
        on_start = "[GetVariableSystem.Clear('omni_bl_action_feedback')]"
        on_start = "[GetVariableSystem.Clear('omni_bloodline_browser')]"
        on_start = "[ExecuteConsoleCommand('gui.ClearWidgets omni_bloodline_browser')]"
    }

    top_window_header_for_layout = {
        position = { 0 8 }
        size = { 100% 40 }
        parentanchor = top|left
        widgetanchor = top|left
        blockoverride "FlagOrIcon" {
            icon = {
                texture = "gfx/interface/base_parts/yellow_button_color_200fs.dds"
                framesize = { 100 100 }
                frame = 6
                position = { -2 -2 }
                size = { 32 32 }
                modify_texture = {
                    texture = "gfx/interface/icons/menu_buttons/menu_bloodlines.dds"
                    blend_mode = alphamultiply
                }
            }
        }
        blockoverride "Title_text" { text = "omni_bl_title" }
        blockoverride "White_buttons" {
            button_close = {
                shortcut = "close_window"
                tooltip = "CLOSE"
                onclick = "[PdxGuiTriggerAllAnimations('omni_bl_close_panel')]"
            }
        }
    }
    textbox = { position = { 20 54 } size = { 310 28 } using = BaseFontM text = "omni_bl_catalogue" }
widget = {
        position = { 850 56 } size = { 130 30 }
        list_button = {
            size = { 100% 100% }
            tooltip = "omni_bl_refresh_tt"
            onclick = "[GetScriptedGui('omni_bl_refresh').Execute( GuiScope.SetRoot( Player.MakeScope ).End )]"
        }
        textbox = {
            position = { 0 -1 }
            parentanchor = center
            widgetanchor = center
            using = BaseFontS
            autoresize = yes
            max_width = 114
            align = center
            text = "omni_bl_refresh"
            alwaystransparent = yes
        }
    }
widget = {
        position = { 20 80 } size = { 145 30 }
        enabled = "[Not(GetVariableSystem.Exists('omni_bl_living_only'))]"
        list_button = {
            size = { 100% 100% }
            tooltip = "omni_bl_living_lines"
            onclick = "[GetVariableSystem.Set('omni_bl_living_only', 'yes')]"
        }
        textbox = {
            position = { 0 -1 }
            parentanchor = center
            widgetanchor = center
            using = BaseFontS
            autoresize = yes
            max_width = 129
            align = center
            text = "omni_bl_living_lines"
            alwaystransparent = yes
        }
    }
widget = {
        position = { 170 80 } size = { 145 30 }
        enabled = "[GetVariableSystem.Exists('omni_bl_living_only')]"
        list_button = {
            size = { 100% 100% }
            tooltip = "omni_bl_all_lines"
            onclick = "[GetVariableSystem.Clear('omni_bl_living_only')]"
        }
        textbox = {
            position = { 0 -1 }
            parentanchor = center
            widgetanchor = center
            using = BaseFontS
            autoresize = yes
            max_width = 129
            align = center
            text = "omni_bl_all_lines"
            alwaystransparent = yes
        }
    }
    scrollarea = {
        position = { 20 120 } size = { 302 528 }
        using = VerticalScrollAreaCutOff
        scrollbarpolicy_horizontal = always_off
        scrollbar_vertical = { using = VerticalScrollBar }
        scrollwidget = {
            vbox = {
                spacing = 3
                widget = {
                    size = { 280 54 }
                    visible = "[Or(Not(GetVariableSystem.Exists('omni_bl_living_only')), GreaterThan_CFixedPoint(Player.MakeScope.Var('omni_bl_count_blood_of_sea_elves').GetValue, '(CFixedPoint)0'))]"
