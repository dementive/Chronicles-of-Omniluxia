        visible = "[GreaterThan_CFixedPoint(Player.MakeScope.Var('omni_bl_visible_count').GetValue, Player.MakeScope.Var('omni_bl_shown_count').GetValue)]"
        list_button = {
            size = { 100% 100% }
            tooltip = "omni_bl_show_all_tt"
            onclick = "[GetScriptedGui('omni_bl_show_all').Execute( GuiScope.SetRoot( Player.MakeScope ).End )]"
        }
        textbox = {
            position = { 0 -1 }
            parentanchor = center
            widgetanchor = center
            using = BaseFontS
            autoresize = yes
            max_width = 114
            align = center
            text = "omni_bl_show_all"
            alwaystransparent = yes
        }
    }

    textbox = {
        position = { 340 400 } size = { 620 60 } using = BaseFontM multiline = yes
        visible = "[IsDataModelEmpty(Player.MakeScope.GetList('omni_bl_holders'))]"
        text = "omni_bl_empty"
    }
    scrollarea = {
        position = { 340 392 } size = { 640 256 }
        using = VerticalScrollAreaCutOff
        scrollbarpolicy_horizontal = always_off
        scrollbar_vertical = { using = VerticalScrollBar }
