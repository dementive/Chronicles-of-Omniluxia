# OMNILUXIA CUSTOM ACHIEVEMENTS - TEXT FORMATTING
# Adds the #huge text tag used by the achievement unlock toast description.
textformatting = {
    # Localization uses named tags; raw #COLOR:{...} tags are not supported.
    format = { name = omni_hc_weak_color format = "color:{0.95,0.36,0.36}" }
    format = { name = omni_hc_fragile_color format = "color:{0.95,0.65,0.30}" }
    format = { name = omni_hc_established_color format = "color:{0.50,0.70,1.00}" }
    format = { name = omni_hc_respected_color format = "color:{0.38,0.82,0.48}" }
    format = { name = omni_hc_supreme_color format = "color:{0.78,0.56,1.00}" }
    # Bloodline eligibility colors.
    format = { name = omni_bl_race_arame format = "color:{0.92,0.70,0.87}" }
    format = { name = omni_bl_race_copper_dwarf format = "color:{1.00,0.65,0.40}" }
    format = { name = omni_bl_race_dragkhanic format = "color:{1.00,0.53,0.43}" }
    format = { name = omni_bl_race_forest_elf format = "color:{0.55,0.84,0.47}" }
    format = { name = omni_bl_race_goblin format = "color:{0.77,0.85,0.39}" }
    format = { name = omni_bl_race_gold_dwarf format = "color:{1.00,0.82,0.39}" }
    format = { name = omni_bl_race_half_elf format = "color:{0.80,0.67,1.00}" }
    format = { name = omni_bl_race_halfling format = "color:{1.00,0.76,0.54}" }
    format = { name = omni_bl_race_high_elf format = "color:{0.94,0.85,1.00}" }
    format = { name = omni_bl_race_hobgoblin format = "color:{0.85,0.77,0.47}" }
    format = { name = omni_bl_race_human format = "color:{0.98,0.89,0.69}" }
    format = { name = omni_bl_race_mycelar format = "color:{0.95,0.62,0.73}" }
    format = { name = omni_bl_race_sea_elf format = "color:{0.43,0.88,0.96}" }
    format = { name = omni_bl_race_silver_dwarf format = "color:{0.73,0.84,0.98}" }
    format = { name = omni_bl_race_silver_halfling format = "color:{0.87,0.92,1.00}" }
    format = { name = omni_bl_race_snakefolk format = "color:{0.42,0.87,0.68}" }
    format = { name = omni_bl_race_vampire format = "color:{1.00,0.49,0.65}" }
    format = {
        name = huge
        format = "size:17"
    }
}
