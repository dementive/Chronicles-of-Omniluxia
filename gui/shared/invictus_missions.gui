# Nations with missions for the start screen
# used in multiplayer_lobby.gui
types INV {
	type flow_mission_rows = flowcontainer {
		direction = vertical
		parentanchor = hcenter
		spacing = 5

		flowcontainer = {
			parentanchor = hcenter
			spacing = 5
			block "1" {}
		}
		flowcontainer = {
			parentanchor = hcenter
			spacing = 5
			block "2" {}
		}
		flowcontainer = {
			parentanchor = hcenter
			spacing = 5
			block "3" {}
		}
		flowcontainer = {
			parentanchor = hcenter
			spacing = 5
			block "4" {}
		}
	}

