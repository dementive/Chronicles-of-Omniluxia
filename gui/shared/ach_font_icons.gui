# OMNILUXIA CUSTOM ACHIEVEMENTS - FONT ICONS
# These let the unlock toast (events/omni_achievements_events.txt) embed the
# achievement picture inline via @ach_<key>! in localization.
# Use the same custom texture here and in the achievements window.

texticon = {
    icon = ach_royal_progress
    iconsize = { texture = "gfx/interface/icons/achievements/omni_ach_royal_progress.dds" size = { 50 50 } offset = { 0 27 } fontsize = 10 }
}

