pdxmesh = {
	name = "golden_dwarf_fort_mesh"
	file = "golden_dwarf_fort2.mesh"

	meshsettings = {
		name = "mesopotamian_fort_decalShape"
		index = 0
		texture_diffuse = "stone_tiles_diffuse.dds"
		texture_normal = "stone_tiles_normal.dds"
