pdxmesh = {
    name = "omni_sun_eagle_mesh"
    file = "omni_sun_eagle.mesh"
    animation = { id = "wingbeat" type = "omni_sun_eagle_wingbeat.anim" }
    meshsettings = {
        name = "omni_sun_eagle_shape"
        index = 0
        texture_diffuse = "omni_sun_eagle_diffuse.dds"
        texture_normal = "omni_sun_eagle_normal.dds"
        texture_specular = "omni_aux_properties.dds"
        shader = "standard"
        shader_file = "gfx/FX/pdxmesh.shader"
    }
}

entity = {
    name = "omni_sun_eagle_entity"
    pdxmesh = "omni_sun_eagle_mesh"
    scale = 9
    get_state_from_parent = no
    default_state = "idle"
    state = { name = "idle" animation = "wingbeat" looping = yes }
}

entity = {
    name = "omni_eagle_handler_entity"
    clone = "forest_elf_gfx_light_infantry"
    attach = { root = "omni_sun_eagle_entity" }
}
