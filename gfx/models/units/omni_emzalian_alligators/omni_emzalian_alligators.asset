pdxmesh = {
	name = "omni_emzalian_alligators_mesh"
	file = "omni_emzalian_alligators.mesh"

	meshsettings = {
		name = "pCubeShape1"
		index = 0
		shader = "Collision"
		shader_file = "gfx/FX/pdxmesh.shader"
	}
	
	animation = { id = "walk" type = "omni_emzalian_alligators_walk.anim" }
	animation = { id = "lunge" type = "omni_emzalian_alligators_lunge.anim" }

	animation = { id = "idle" type = "omni_emzalian_alligators_idle.anim" }

	meshsettings = {
		name = "Mesh2Shape"
		index = 0
		texture_diffuse = "omni_emzalian_alligators_diffuse.dds"
		texture_normal = "omni_emzalian_alligators_normal.dds"
		texture_specular = "omni_aux_properties.dds"
		shader = "standard"
		shader_file = "gfx/FX/pdxmesh.shader"
	}
}

entity = {
    name = "omni_emzalian_alligators_entity"
    pdxmesh = "omni_emzalian_alligators_mesh"
    scale = 0.85
    default_state = "idle"
    state = { name = "idle" animation = "idle" looping = yes }
    state = { name = "move" animation = "walk" looping = yes }
