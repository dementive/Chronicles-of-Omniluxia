# Omniluxia sword family (tools/model_pipeline/units/swords.py). Entity = omx_sword_<shape>[_z]_<finish>_entity
# _z = same sword stood upright for spear-animation slots. Finishes share one atlas layout.

pdxmesh = {
	name = "omx_sword_gladius_iron_mesh"
	file = "omx_sword_gladius.mesh"
	meshsettings = {
		name = "omx_sword_gladiusShape"
		index = 0
		texture_diffuse = "omx_props_sw_iron_diffuse.dds"
		texture_normal = "omx_props_normal.dds"
		texture_specular = "omx_props_properties.dds"
		shader = "standard"
		shader_file = "gfx/FX/pdxmesh.shader"
	}
}
