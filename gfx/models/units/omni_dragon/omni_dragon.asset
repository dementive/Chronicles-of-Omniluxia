pdxmesh = {
    name = "omni_morrigon_army_mesh"
    file = "omni_morrigon_army.mesh"
    cull_distance = 3000
    animation = { id = "circle" type = "morrigon_circle.anim" }
    animation = { id = "travel" type = "morrigon_travel.anim" }
    animation = { id = "poise" type = "morrigon_poise.anim" }
    animation = { id = "strike" type = "morrigon_strike.anim" }
    animation = { id = "evade" type = "morrigon_evade.anim" }
    meshsettings = {
        name = "jorodoxShape"
        index = 0
        texture_diffuse = "omni_morrigon_diffuse.dds"
        texture_normal = "omni_morrigon_normal.dds"
        texture_specular = "omni_morrigon_properties.dds"
        shader = "standard"
        shader_file = "gfx/FX/pdxmesh.shader"
    }
}

entity = {
    name = "omni_morrigon_army_entity"
    pdxmesh = "omni_morrigon_army_mesh"
    scale = 0.54
    default_state = "idle"
    state = { name = "idle" animation = "circle" looping = yes }
    state = { name = "move" animation = "travel" looping = yes }
    state = { name = "force_march" animation = "travel" looping = yes }
    state = { name = "retreat" animation = "travel" looping = yes }
    state = { name = "raiding" animation = "strike" looping = yes }
    state = { name = "recruiting" animation = "poise" looping = yes }
    state = { name = "recruit" animation = "poise" looping = yes }
    state = { name = "build_road_2" animation = "travel" looping = yes }
    state = { name = "build_road" animation = "travel" looping = yes }
    state = { name = "combat_ready" animation = "poise" looping = yes }
    state = { name = "army_drill" animation = "poise" looping = yes }
    state = { name = "cheer" animation = "poise" looping = yes }
    state = { name = "offensive_successful" animation = "strike" looping = no next_state = combat_ready }
    state = { name = "offensive_dodge" animation = "strike" looping = no next_state = combat_ready }
    state = { name = "offensive_block" animation = "strike" looping = no next_state = combat_ready }
