    state = { name = "offensive_sequence_2" animation = "strike" looping = no next_state = combat_ready }
    state = { name = "offensive_sequence_3" animation = "strike" looping = no next_state = combat_ready }
    state = { name = "offensive_sequence_4" animation = "strike" looping = no next_state = combat_ready }
    state = { name = "offensive_sequence_5" animation = "strike" looping = no next_state = combat_ready }
    state = { name = "defensive_hit" animation = "evade" looping = no next_state = combat_ready }
    state = { name = "defensive_dodge" animation = "evade" looping = no next_state = combat_ready }
    state = { name = "defensive_block" animation = "evade" looping = no next_state = combat_ready }
    state = { name = "defensive_counter" animation = "strike" looping = no next_state = combat_ready }
    state = { name = "defensive_sequence_1" animation = "evade" looping = no next_state = combat_ready }
    state = { name = "defensive_sequence_2" animation = "evade" looping = no next_state = combat_ready }
